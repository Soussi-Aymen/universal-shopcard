# Copy this file to .env and configure your keys
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: gemini-2.0-flash | gemini-2.5-flash | gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash
# Set true to skip Gemini API entirely (recommended when free-tier quota is exhausted)
GEMINI_OFFLINE_ONLY=false
BITREFILL_API_KEY=your_bitrefill_api_key_here   # not "mock" for live MCP catalog + checkout

BITREFILL_API_URL=https://api.bitrefill.com/mcp
BITREFILL_API_V2_URL=https://api.bitrefill.com/v2

# Developer checkout (uses your Bitrefill account balance — same backend as MCP buy-products)
BITREFILL_PAYMENT_METHOD=balance              # balance = developer credits; bitcoin = crypto QR invoice
BITREFILL_BALANCE_CURRENCY=EUR                # EUR | USD | XBT — which sub-account to debit
BITREFILL_INCLUDE_TEST_PRODUCTS=true          # true = show free test-gift-card-code ($0 full demo)
BITREFILL_ENABLE_PAYMENT=true                 # set false only to block checkout

PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
